# =============================================================================
# Respiratory-phase-locked EEG responses to odors -- reproducible workflow
#
#   snakemake -n               # dry run: show what would be executed
#   snakemake -c4              # run everything with 4 cores
#   snakemake --dag | dot -Tpdf > dag.pdf
#   snakemake --configfile config/test.yaml -c2   # synthetic-data smoke test
#
# EXPENSIVE STEPS ARE GUARDED.  make_epochs, make_full_recordings, ersp_*, pac_compute and recordings_meta wrap all their
# inputs in ancient(): they run only when their OUTPUT IS MISSING (or when forced:  snakemake --forcerun <rule>), never merely
# because a code file or a downloaded data file has a newer timestamp.  This is what lets someone who downloads the data
# deposit (which already contains such outputs) regenerate the figures without triggering hours of recomputation.
# Cheap steps (classification, habituation, statistics, figures) track their inputs and code normally.
#
# NOTE: every rule lists the code it runs under `code=` so that editing a script or a module in src/
# re-runs the affected steps (Snakemake cannot see inside `python scripts/x.py` otherwise).
#
# Stages (more are added as the notebooks are ported):
#   0. epochs          raw EEGLAB .mat + olfactometer CSV -> epochs (+ continuous recordings)  [needs raw data]
#   1. ersp            epochs               ->  phase-aligned, 3.78-s and 2-s time-aligned ERSPs
#   2. classification  ERSPs                ->  Table S1/S4, Fig. 4A/B + S3 data, predictions for the word analysis
#   3. habituation     phase ERSP           ->  early-vs-late AUCs, FDR p-values, Fig. 5 data
#   4. figures         results              ->  Fig. 4A/B, Fig. S3, Fig. 5
#   5. PAC             continuous recordings -> respiration-EEG coupling (SLOW), group stats, Fig. 2   [pac.run: true]
#   8. timing          v2 epochs + continuous respiration -> odor-arrival timing, Tables S5-S6          [timing.run: true]
#   7. breath stats    original epochs -> breath durations by condition, Table S3                      [breath.run: true]
#   9. subject 28      original epochs + phase ERSP -> SI 1.4 (retention vs breathing rate), Table S7        [subject28.run: true]
#  10. cluster perm.  3 ERSP files -> Section 1.5 cluster tests (theta / alpha), Fig. S4                         [cluster_perm.run: true]
#  11. Fig. 3         3 ERSP/epochs files -> Fig. 3 (schematic, two subjects, grand averages)                         [fig3.run: true]
#  12. Fig. 1 trace   raw respiration -> example trace of Fig. 1 (right panel); the small snippet file is deposited   [fig1_resp.run: true]
#  13. Fig. S2         spectra cache -> example FOOOF fits with / without a peak                                      [fooof.run: true]
#  14. word scoring    free responses + GoodScents + word embeddings -> Fig. 4C/D, Section 1.6, SI 3.1                  [word_scoring.run: true]
#   6. FOOOF gating    PAC results + spectra -> Section 1.2, Table S2                                  [fooof.run: true]
# =============================================================================
import os
import yaml

configfile: "config/config.yaml"

P = config["paths"]
RES = P["results"]
FIG = P["figures"]
CLS = config["classification"]
HAB = config["habituation"]
PAC = config["pac"]
FOOOF = config["fooof"]
BREATH = config["breath"]
