# --------------------------------------------------------------------------- 5. respiration-EEG PAC (Fig. 2)
rule pac_compute:
    """PAC (MI + 1000 circular-shift surrogates) per subject/channel/band.  SLOW (hours).  A previously computed result
    placed at paths.pac_results is used as is."""
    input:
        recordings=ancient(P["full_recordings_dir"] + "/full_respiration_EEG_humidity.npy"),
        params=ancient(f"{RES}/pac/params.yaml"),
        code=ancient(["scripts/run_pac.py", "src/olfaction_eeg/pac.py"]),
    output:
        P["pac_results"],
    log:
        f"{RES}/logs/pac_compute.log",
    shell:
        "python scripts/run_pac.py --recordings {input.recordings} --params {input.params} --out {output} > {log} 2>&1"


rule recordings_meta:
    """Channel names / electrode positions / bad channels of the humidity recordings (a few KB instead of several GB)."""
    input:
        recordings=ancient(P["full_recordings_dir"] + "/full_respiration_EEG_humidity.npy"),
        code=ancient(["scripts/make_recordings_meta.py", "src/olfaction_eeg/recordings.py"]),
    output:
        P["full_recordings_dir"] + "/full_respiration_EEG_humidity_meta.npy",
    shell:
        "python scripts/make_recordings_meta.py --recordings {input.recordings} --out {output}"


rule fig2:
    """Fig. 2 and Section 1.1: whole-head PAC statistics, cluster permutation tests, topoplots."""
    input:
        pac=P["pac_results"],
        meta=P["full_recordings_dir"] + "/full_respiration_EEG_humidity_meta.npy",
        info=P["info_dir"] + "/subject" + str(PAC.get("plot_info_subject", "22")) + "_info.fif",
        params=f"{RES}/pac/params.yaml",
        code=["scripts/make_fig2_pac.py", "src/olfaction_eeg/pac_stats.py", "src/olfaction_eeg/pac_figure.py",
              "src/olfaction_eeg/classify.py", "src/olfaction_eeg/checks.py"],
    output:
        f"{FIG}/fig2_pac.pdf",
        f"{FIG}/fig2_pac.png",
        f"{RES}/pac/pac_group_stats.csv",
        f"{RES}/pac/pac_subject_level.csv",
        f"{RES}/pac/pac_clusters.csv",
        f"{RES}/pac/pac_stats_results.pkl",
        f"{RES}/pac/pac_checks.csv",
    params:
        outdir=f"{RES}/pac",
        figdir=FIG,
        strict="--strict" if config["checks"]["strict"] else "",
    log:
        f"{RES}/logs/fig2.log",
    shell:
        "python scripts/make_fig2_pac.py --pac-results {input.pac} --recordings-meta {input.meta} --info-fif {input.info} "
        "--params {input.params} --out-dir {params.outdir} --fig-dir {params.figdir} {params.strict} > {log} 2>&1"


# --------------------------------------------------------------------------- 6. oscillatory gating of the PAC effects
rule psd_cache:
    """Welch spectra of all channels (needs the continuous EEG; a few MB result, part of the data deposit)."""
    input:
        recordings=ancient(P["full_recordings_dir"] + "/full_respiration_EEG_humidity.npy"),
        pac=ancient(P["pac_results"]),
        params=ancient(f"{RES}/fooof/params.yaml"),
        code=ancient(["scripts/make_psd_cache.py", "src/olfaction_eeg/fooof_gating.py", "src/olfaction_eeg/pac.py"]),
    output:
        P["psd_cache"],
    log:
        f"{RES}/logs/psd_cache.log",
    shell:
        "python scripts/make_psd_cache.py --recordings {input.recordings} --pac-results {input.pac} "
        "--params {input.params} --out {output} > {log} 2>&1"


rule fooof_gating:
    """Section 1.2 / Table S2: PAC restricted to channels with a genuine oscillatory peak; inhale vs exhale aperiodic."""
    input:
        psd=P["psd_cache"],
        pac=P["pac_results"],
        params=f"{RES}/fooof/params.yaml",
        code=["scripts/run_fooof_gating.py", "src/olfaction_eeg/fooof_gating.py", "src/olfaction_eeg/pac_stats.py",
              "src/olfaction_eeg/classify.py", "src/olfaction_eeg/checks.py"],
    output:
        f"{RES}/fooof/table_S2_long.csv",
        f"{RES}/fooof/table_S2.csv",
        f"{RES}/fooof/peak_prevalence.csv",
        f"{RES}/fooof/gated_vs_all_channels.csv",
        f"{RES}/fooof/aperiodic_inhale_exhale.csv",
        f"{RES}/fooof/fooof_checks.csv",
    params:
        outdir=f"{RES}/fooof",
        strict="--strict" if config["checks"]["strict"] else "",
    log:
        f"{RES}/logs/fooof_gating.log",
    shell:
        "python scripts/run_fooof_gating.py --psd-cache {input.psd} --pac-results {input.pac} --params {input.params} "
        "--out-dir {params.outdir} {params.strict} > {log} 2>&1"


