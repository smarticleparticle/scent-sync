# --------------------------------------------------------------------------- 8. odor-arrival timing (Section 1.8, Tables S5-S6)
rule timing_inputs:
    """Small inputs of the timing analysis: respiration + timestamps of the v2 epochs, and the continuous respiration (no EEG)."""
    input:
        epochs=ancient(P["epochs_rebuilt"]),
        full=ancient(P["full_recordings_dir"] + "/full_respiration_EEG_v2.npy"),
        code=ancient(["scripts/make_timing_inputs.py", "src/olfaction_eeg/deposit.py", "src/olfaction_eeg/compat.py"]),
    output:
        epochs=P["epochs_v2_for_timing"],
        continuous=P["continuous_respiration_v2"],
    shell:
        "python scripts/make_timing_inputs.py --epochs-v2 {input.epochs} --full-recordings {input.full} "
        "--out-epochs {output.epochs} --out-continuous {output.continuous}"


rule timing:
    """Did the odor reach the nostrils by inhalation onset?  Trial timing, Table S5 (lag by subject), Table S6 (flow-rate sensitivity)."""
    input:
        epochs=P["epochs_v2_for_timing"],
        continuous=P["continuous_respiration_v2"],
        params=f"{RES}/timing/params.yaml",
        code=["scripts/run_timing.py", "src/olfaction_eeg/timing.py", "src/olfaction_eeg/breath.py", "src/olfaction_eeg/checks.py"],
    output:
        f"{RES}/timing/timing_trials.csv",
        f"{RES}/timing/table_S5_lag_by_subject.csv",
        f"{RES}/timing/table_S6_flow_sensitivity.csv",
        f"{RES}/timing/timing_summary.csv",
        f"{RES}/timing/timing_checks.csv",
    params:
        outdir=f"{RES}/timing",
        strict="--strict" if config["checks"]["strict"] else "",
    log:
        f"{RES}/logs/timing.log",
    shell:
