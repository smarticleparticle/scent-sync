    input:
        ALL_TARGETS,


rule versions:
    """Record the software versions used, next to the results."""
    output:
        f"{RES}/versions.txt",
    shell:
        "python scripts/print_versions.py {output} > /dev/null"


# --------------------------------------------------------------------------- 0. raw -> epochs
rule make_epochs:
    """Raw EEGLAB-preprocessed EEG + olfactometer humidity -> epochs (EEG, respiration, timestamps)."""
    input:
        mats=ancient(expand(P["raw_eeglab"], subject=SUBJECTS)),
        csvs=ancient(expand(P["raw_olfactometer"], subject=SUBJECTS)),
        params=ancient(f"{RES}/recordings/params.yaml"),
        code=ancient(["scripts/make_epochs.py", "src/olfaction_eeg/recordings.py"]),
    output:
        P["epochs_rebuilt"],
    log:
        f"{RES}/logs/make_epochs.log",
    shell:
        "python scripts/make_epochs.py --params {input.params} --out {output} > {log} 2>&1"


rule make_full_recordings:
    """Continuous aligned EEG + respiration.  kind=v2 (z-scored; timing) or humidity (min-max; PAC).
    Not needed by stages 1-2; request explicitly:  snakemake recordings"""
    input:
        mats=ancient(expand(P["raw_eeglab"], subject=SUBJECTS)),
        csvs=ancient(expand(P["raw_olfactometer"], subject=SUBJECTS)),
        params=ancient(f"{RES}/recordings/params.yaml"),
        code=ancient(["scripts/make_full_recordings.py", "src/olfaction_eeg/recordings.py"]),
    output:
        P["full_recordings_dir"] + "/full_respiration_EEG_{kind}.npy",
    wildcard_constraints:
        kind="v2|humidity",
    params:
        variant=lambda wc: {"v2": "zscore", "humidity": "minmax_smooth"}[wc.kind],
    log:
        RES + "/logs/make_full_recordings_{kind}.log",
    shell:
        "python scripts/make_full_recordings.py --params {input.params} --variant {params.variant} "
        "--out {output} > {log} 2>&1"


rule recordings:
    """Convenience target: both continuous-recording files."""
    input:
        expand(P["full_recordings_dir"] + "/full_respiration_EEG_{kind}.npy", kind=["v2", "humidity"]),


# --------------------------------------------------------------------------- 1. ERSP
rule ersp_phase_aligned:
    """Respiratory-phase-locked ERSP (0-360 deg, 1-deg bins), averaged over ROI channels."""
    input:
        epochs=ancient(P["epochs"]),
        info=ancient(P["info_dir"]),
        code=ancient("scripts/generate_ersp.py"),
    output:
        f"{RES}/ersp/phase_aligned_fullbreath_1deg.npy",
    params:
        exclude=",".join(config["subjects"]["ersp_exclude"]),
    threads: 12
    log:
        f"{RES}/logs/ersp_phase_aligned.log",
    shell:
        "python scripts/generate_ersp.py run --phase_aligned=True "
        "--epochs_file={input.epochs} --info_dir={input.info} "
        "--out_file={output} --exclude_subjects={params.exclude} --n_jobs={threads} > {log} 2>&1"


rule ersp_time_aligned:
    """Inhale-onset-locked ERSP, -0.5 s to <window> s.  window = long (3.78 s, avg first breath) or short (2 s)."""
    input:
        epochs=ancient(P["epochs"]),
        info=ancient(P["info_dir"]),
        code=ancient("scripts/generate_ersp.py"),
    output:
        f"{RES}/ersp/time_aligned_{{window}}.npy",
    wildcard_constraints:
        window="short|long",
    params:
        exclude=",".join(config["subjects"]["ersp_exclude"]),
        end=lambda wc: config["ersp"][f"time_{wc.window}_end"],
    threads: 12
    log:
        f"{RES}/logs/ersp_time_aligned_{{window}}.log",
    shell:
        "python scripts/generate_ersp.py run --phase_aligned=False "
        "--epochs_file={input.epochs} --info_dir={input.info} "
        "--out_file={output} --exclude_subjects={params.exclude} "
        "--time_window_end={params.end} --n_jobs={threads} > {log} 2>&1"


# --------------------------------------------------------------------------- 2. classification
rule classification:
    """Odor-vs-water classification: RPL-ERSP vs time-locked ERSP (Table S1, Table S4, Fig. 4 data)."""
    input:
        phase=f"{RES}/ersp/phase_aligned_fullbreath_1deg.npy",
        time_long=f"{RES}/ersp/time_aligned_long.npy",
        time_short=f"{RES}/ersp/time_aligned_short.npy",
        params=f"{RES}/classification/params.yaml",
        code=["scripts/run_classification.py", "src/olfaction_eeg/classify.py", "src/olfaction_eeg/features.py",
              "src/olfaction_eeg/checks.py"],
    output:
        summary=f"{RES}/classification/classification_summary.csv",
        pkl=f"{RES}/classification/classification_results.pkl",
        search=f"{RES}/classification/strategy_search.csv",
        s1=f"{RES}/classification/table_S1.csv",
        s4=f"{RES}/classification/table_S4.csv",
        checks=f"{RES}/classification/classification_checks.csv",
        neural=f"{RES}/classification/neural_predictions_early.csv",
    params:
        outdir=f"{RES}/classification",
        strict="--strict" if config["checks"]["strict"] else "",
    log:
        f"{RES}/logs/classification.log",
    shell:
        "python scripts/run_classification.py --phase {input.phase} --time-short {input.time_short} "
        "--time-long {input.time_long} --params {input.params} --out-dir {params.outdir} "
        "{params.strict} > {log} 2>&1"


