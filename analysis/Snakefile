        f"{RES}/word_scoring/behavior_summary.csv",
        f"{RES}/word_scoring/behavior_tests.csv",
        f"{RES}/word_scoring/si31_neural_behavior_correlation.csv",
        f"{RES}/word_scoring/embedding_versions.json",
        f"{RES}/word_scoring/word_scoring_checks.csv",
        f"{FIG}/fig4CD_recognition.pdf",
        f"{FIG}/fig4CD_recognition.png",
    params:
        outdir=f"{RES}/word_scoring",
        figdir=FIG,
        strict="--strict" if config["checks"]["strict"] else "",
    log:
        f"{RES}/logs/word_scoring.log",
