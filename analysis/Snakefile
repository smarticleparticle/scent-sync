# --------------------------------------------------------------------------- parameter files
# The exact parameters of each stage are written to results/<stage>/params.yaml when the workflow is parsed (only if the
# content changed, so unchanged parameters keep their timestamp).  They are ordinary input files without a producing job:
# a fresh checkout therefore never re-triggers an expensive step merely because a params file had to be created.
def write_params(path, content):
    text = yaml.safe_dump(content, sort_keys=False)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    if not (os.path.exists(path) and open(path).read() == text):
        with open(path, "w") as f:
            f.write(text)


write_params(f"{RES}/recordings/params.yaml", {
    "subjects": SUBJECTS,
    "eeglab_fmt": P["raw_eeglab"],
    "csv_fmt": P["raw_olfactometer"],
    "cfg": {
        "tmin": REC["tmin"], "tmax": REC["tmax"], "resp_sfreq": REC["resp_sfreq"],
        "resp_clip": REC["resp_clip"], "minmax_smooth_window": REC["minmax_smooth_window"],
        "csv_drop_first_rows": REC["csv_drop_first_rows"],
        "bad_channels": REC["bad_channels"],
        "offsets": REC["eeg_resp_offset_samples"],
        "drop_last_kept_epoch": REC["corrections"]["drop_last_kept_epoch"],
        "shift_kept_indices": REC["corrections"]["shift_kept_indices"],
        "drop_first_trial": REC["corrections"]["drop_first_trial"],
    },
})
write_params(f"{RES}/classification/params.yaml", {
    **{k: CLS[k] for k in ["C", "trial_start", "trial_end", "seed", "phase_strategies", "phase_main_strategy",
                           "time_strategies_2s", "time_strategies_378s", "time_378s_comparison_strategy", "gap_test"]},
    "odors": config["odors"], "normosmia": config["subjects"]["normosmia"], "paper": PAPER,
    "checks_enabled": config["checks"]["enabled"],
})
write_params(f"{RES}/habituation/params.yaml", {
    "C": CLS["C"], "phase_strategies": CLS["phase_strategies"], "phase_main_strategy": CLS["phase_main_strategy"],
    "habituation": HAB, "odors": config["odors"], "normosmia": config["subjects"]["normosmia"],
    "paper": PAPER, "checks_enabled": config["checks"]["enabled"],
})
write_params(f"{RES}/timing/params.yaml", {
    "timing": TIMING, "paper": PAPER, "checks_enabled": config["checks"]["enabled"],
})
write_params(f"{RES}/breath/params.yaml", {
