    "fig3": FIG3, "odors": config["odors"], "normosmia": config["subjects"]["normosmia"], "paper": PAPER,
    "checks_enabled": config["checks"]["enabled"],
})
write_params(f"{RES}/fig1/params.yaml", {"offsets": REC["eeg_resp_offset_samples"]})
write_params(f"{RES}/word_scoring/params.yaml", {
    "word_scoring": WS, "paper": PAPER, "checks_enabled": config["checks"]["enabled"],
